                                        BorderBrush="#DDF3E7"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="12,9"
                                        Margin="12"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="正在生成" Foreground="{StaticResource WechatGreenDark}" FontWeight="SemiBold" Margin="0,0,12,0"/>
