                                        <StackPanel x:Name="PersonMemoSuggestionList"/>
                                    </StackPanel>
                                </Border>
                                <ComboBox x:Name="PersonViewModeCombo"
                                          Width="132"
                                          Height="40"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,12,12"
                                          SelectionChanged="SummaryViewModeChanged"
                                          SelectedIndex="0"
                                          Visibility="Collapsed">
                                    <ComboBoxItem Content="文档视图"/>
                                </ComboBox>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <GridSplitter x:Name="PersonGridSplitter"
                                  Grid.Column="1"
                                  Width="16"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Cursor="SizeWE"
                                  Background="Transparent"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Columns"
                                  ShowsPreview="False">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Grid Background="Transparent">
                                    <Border Width="2"
                                            Height="56"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#CBD5E1"
                                            CornerRadius="999"
                                            Opacity="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=GridSplitter}}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>
                    <Border x:Name="PersonEvidencePanel" Grid.Column="2" Style="{StaticResource SurfaceCard}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="原文" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                                <Button x:Name="PersonSpeakerFilterButton"
                                        Grid.Column="1"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="34"
                                        Padding="10,0"
                                        Content="发言人"
                                        Visibility="Collapsed"
                                        Click="ToggleSpeakerFilterClicked"/>
                            </Grid>
                            <Popup x:Name="PersonSpeakerFilterPopup"
                                   DockPanel.Dock="Top"
                                   PlacementTarget="{Binding ElementName=PersonSpeakerFilterButton}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="16" Padding="14" MinWidth="280" MaxWidth="360">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="发言人筛选" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="全部" Padding="8,2" MinHeight="26" Click="ClearSpeakerFilterClicked"/>
                                        </Grid>
                                        <TextBlock Text="会影响右侧原文，也会影响下一次 AI 总结。"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>
                                        <TextBox x:Name="PersonSpeakerSearchBox"
                                                 Height="36"
                                                 Margin="0,0,0,10"
                                                 Padding="12,0"
                                                 VerticalContentAlignment="Center"
                                                 BorderBrush="#E0E7EF"
                                                 BorderThickness="1"
                                                 Background="#F8FAFC"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 Tag="搜索发言人"
                                                 Visibility="Collapsed"
                                                 TextChanged="SpeakerFilterSearchChanged"/>
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="PersonSpeakerFilterList"/>
                                        </ScrollViewer>
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="应用并重新生成"
                                                Margin="0,10,0,0"
                                                Click="ApplySpeakerFilterAndRegenerateClicked"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <TextBlock x:Name="PersonEvidenceSubtitle"
                                       DockPanel.Dock="Top"
                                       Text="生成后显示相关消息。"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,0,0,14"/>
                            <ListBox x:Name="PersonEvidenceList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBoxItem IsHitTestVisible="False" Focusable="False">
                                    <TextBlock Text="选择好友并生成后，可在这里核对原始消息片段。" TextWrapping="Wrap"/>
                                </ListBoxItem>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="MemoPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="记录" Style="{StaticResource PageTitle}"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="White" CornerRadius="14" Padding="6" BorderBrush="#E9EDF3" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="MemoGroupTabButton" Content="群聊" Padding="18,8" Background="#E7F8EF" Foreground="{StaticResource WechatGreenDark}" Click="MemoGroupTabClicked"/>
                            <Button x:Name="MemoPersonTabButton" Content="好友" Padding="18,8" Foreground="{StaticResource TextMuted}" Click="MemoPersonTabClicked"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource SurfaceCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="MemoObjectTitle" Text="群聊" Style="{StaticResource PanelTitle}"/>
                                <TextBlock x:Name="MemoObjectSubtitle" Text="已保存记录" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,16"/>
                            </StackPanel>
                            <ListBox x:Name="MemoObjectList" Grid.Row="1" SelectionChanged="MemoObjectSelectionChanged"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="MemoDetailTitle" Text="最近保存" Style="{StaticResource PanelTitle}"/>
                                    <TextBlock x:Name="MemoDetailSubtitle" Text="暂无选择" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button x:Name="DeleteMemoButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="删除选中"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="DeleteSelectedMemoClicked"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,18,0,0">
                                <ListBox x:Name="MemoEntryList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                <Border x:Name="MemoEmptyState" Background="White" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                                        <lottie:LottieAnimationView ResourcePath="pack://application:,,,/Assets/empty-box.json"
                                                                     Width="190"
                                                                     Height="150"
                                                                     AutoPlay="True"
                                                                     RepeatCount="-1"
                                                                     HorizontalAlignment="Center"
                                                                     Margin="0,0,0,14"/>
                                        <TextBlock Text="还没有保存摘录" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
                                        <TextBlock Text="还没有保存内容。"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   LineHeight="22"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="TemplatePage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="模板中心" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="按使用场景维护 AI 输出格式，群聊和好友模板互不混用。" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Width="22" FontSize="14"/>
                                <TextBlock Text="删除模板"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Click="CreateTemplateFromCenterClicked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Width="22" FontSize="14" Foreground="White"/>
                                <TextBlock Text="新建模板" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource SurfaceCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="模板库" Style="{StaticResource PanelTitle}"/>
                                <TextBlock Text="先选场景，再选具体模板。" Foreground="{StaticResource TextMuted}" Margin="0,6,0,16"/>
                            </StackPanel>
                            <Border Grid.Row="1" Background="#F7F9FC" CornerRadius="14" Padding="6" Margin="0,0,0,14">
                                <ListBox x:Name="TemplateCategoryList" SelectionChanged="TemplateCategoryChanged" BorderThickness="0" Background="Transparent">
                                    <ListBoxItem Content="群聊分析" IsSelected="True"/>
                                    <ListBoxItem Content="好友分析"/>
                                </ListBox>
                            </Border>
                            <ListBox Grid.Row="2" x:Name="TemplateList" SelectionChanged="TemplateSelectionChanged"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="模板编辑" Style="{StaticResource PanelTitle}"/>
                                    <TextBlock Text="模板必须保留 {messages}，生成时会替换成聊天记录。" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="TemplateCategoryBox" Width="150" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <ComboBoxItem Content="群聊分析"/>
                                    <ComboBoxItem Content="好友分析"/>
                                </ComboBox>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,20,0,14">
                                <StackPanel>
                                    <TextBlock Text="模板名称" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TemplateNameBox"/>
                                </StackPanel>
                            </Grid>

                            <DockPanel Grid.Row="2">
                                <TextBlock DockPanel.Dock="Top" Text="提示词内容" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                                <TextBox x:Name="TemplateContentBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="重置" Margin="0,0,10,0" Click="ResetTemplateDetailClicked"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="保存模板" Click="SaveTemplateDetailClicked"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,22">
                    <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="管理 AI 服务、本地数据、导出记录与版本反馈。" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource SurfaceCard}" Padding="22" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="AI 服务" Style="{StaticResource PanelTitle}"/>
                                        <TextBlock Text="填写自己的 AI 服务 API Key 后即可生成总结。Key 只保存在本机。" Foreground="{StaticResource TextMuted}" Margin="0,8,0,12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="保存"
                                                Margin="0,0,10,0"
                                                Click="SaveSettingsClicked"/>
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="检测额度"
                                                Click="RefreshAiBalanceClicked"/>
                                    </StackPanel>
                                </Grid>
                                <PasswordBox x:Name="ApiKeyBox"
                                             Padding="16,11"
                                             ToolTip="请输入你的 AI 服务 API Key。"/>
                                <Border Background="#F7F9FC" CornerRadius="16" Padding="16" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="额度检测" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            <TextBlock x:Name="BalanceDetailText" Text="点击检测额度，同步当前 API Key 返回的可用值。" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="当前可用额度" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="BalanceTotalText" Text="未检测" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="22" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="用户身份识别" Style="{StaticResource PanelTitle}"/>
                                    <TextBlock Text="填写群聊里别人常用来称呼本机用户的名字、昵称或代号。生成总结时，AI 会把这些称呼识别为“我/本机”，避免把用户和对方角色写反。" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                    <TextBox x:Name="SelfAliasesBox"
                                             Tag="例如：小宋、宋工、Avery、产品同学"
                                             ToolTip="多个称呼可用逗号、顿号、空格或换行分隔。"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#F7F9FC" CornerRadius="16" Padding="16" Margin="18,0,0,0" VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="适用范围" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="群聊总结、好友分析、待办识别、角色归因" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SurfaceCard}" Padding="22" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="数据与隐私" Style="{StaticResource PanelTitle}"/>
                                    <TextBlock Text="聊天记录读取在本机完成。生成总结时，只提交当前选择范围内的必要文本。" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,10,0,18"/>
                                    <Border Background="#F7F9FC" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="数据状态" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            <TextBlock x:Name="SettingsDataStatusText" Text="等待初始化。完成后将显示已读取的群聊和好友数量。" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F7F9FC" CornerRadius="16" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="隐私边界" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            <TextBlock Text="好友列表、群聊列表和历史索引不会展示给其他用户；当前工具不提供云端同步。" Foreground="{StaticResource TextPrimary}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="22" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="导出与历史" Style="{StaticResource PanelTitle}"/>
                                    <TextBlock Text="当前版本支持将生成结果导出为 Markdown 文件。历史总结归档、按群聊/好友筛选和默认保存目录会在后续版本完善。" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,10,0,18"/>
                                    <Border Background="#F7F9FC" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="导出格式" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            <TextBlock Text="Markdown / 文本文件" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F7F9FC" CornerRadius="16" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="历史文档" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            <TextBlock Text="暂不自动归档。请在生成后手动导出需要保留的总结。" Foreground="{StaticResource TextPrimary}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SurfaceCard}" Padding="22" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="版本说明" Style="{StaticResource PanelTitle}"/>
                                    <TextBlock Text="ChatBrief 是面向个人使用的本地开源工具，重点覆盖微信数据读取、群聊总结、好友分析和模板输出。后续能力会跟随开源版本持续迭代。" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="22" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="问题反馈" Style="{StaticResource PanelTitle}"/>
                                    <TextBlock Grid.Row="1" Text="生成失败、额度用完或发现异常时，请联系开发者小萌。" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,10,0,12"/>
                                    <Border Grid.Row="2" Background="#F4FBF7" BorderBrush="#DDF3E7" BorderThickness="1" CornerRadius="16" Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="aezakmiavery@gmail.com" Foreground="{StaticResource WechatGreenDark}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Width="34"
                                                    Height="34"
                                                    Padding="0"
                                                    Background="White"
                                                    BorderBrush="#DDF3E7"
                                                    BorderThickness="1"
                                                    ToolTip="复制邮箱"
                                                    Click="CopyDeveloperEmailClicked">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="15" Foreground="{StaticResource WechatGreenDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="CopyBunnyToast"
                                            Grid.RowSpan="3"
                                            Width="154"
                                            Height="154"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-48,40,0"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False">
                                        <lottie:LottieAnimationView x:Name="CopyBunnyAnimation"
                                                                     ResourcePath="pack://application:,,,/Assets/copy-bunny.json"
                                                                     AutoPlay="False"
                                                                     RepeatCount="1"
                                                                     Width="154"
                                                                     Height="154"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Popup x:Name="SelectionMemoPopup"
               Placement="MousePoint"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="#111827"
                    CornerRadius="18"
                    Padding="6"
                    Margin="0,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="7" Direction="270" Opacity="0.18" Color="#1F2937"/>
                </Border.Effect>
                <Button x:Name="SaveSelectionMemoButton"
                        Background="#111827"
                        Foreground="White"
                        Padding="12,8"
                        Click="SaveSelectedTextToMemoClicked"
                        ToolTip="保存到记录">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="{StaticResource WechatGreen}" FontWeight="SemiBold" Margin="0,0,7,0"/>
                        <TextBlock Text="保存到记录" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Border>
        </Popup>
    </Grid>
</Window>



