                                            <Ellipse Style="{StaticResource GeneratingDot}"/>
                                            <Ellipse Style="{StaticResource GeneratingDot}"/>
                                            <Ellipse Style="{StaticResource GeneratingDot}"/>
                                            <Ellipse Style="{StaticResource GeneratingDot}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PersonMemoSuggestionPanel"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Width="380"
                                        Background="#FCFDFE"
                                        BorderBrush="#E5EAF0"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="12"
                                        Margin="0,0,12,12"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="可保存记录"
                                                       Foreground="{StaticResource WechatGreenDark}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"/>
                                            <Button Grid.Column="1"
                                                    Content="×"
                                                    Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="CloseMemoSuggestionsClicked"/>
